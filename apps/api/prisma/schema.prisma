generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & RBAC
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  PRODUCT_MANAGER
  ORDER_MANAGER
  INVENTORY_MANAGER
  SUPPORT_MANAGER
}

// A single table for both customers and admins. role = null means a
// customer; a non-null role is what makes a user an admin. Customer
// auth and admin auth are separate API flows/guards (Sections 19 & 21),
// but they don't need separate storage - see docs/database.md.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  name         String
  role         Role?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses      Address[]
  cart           Cart?
  wishlist       Wishlist?
  orders         Order[]
  reviews        Review[]
  returns        Return[]
  notifications  Notification[]
  auditLogs      AdminAuditLog[]
  stockMovements StockMovement[]

  @@index([role])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("IN")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ordersAsShipping Order[] @relation("ShippingAddress")
  ordersAsBilling  Order[] @relation("BillingAddress")

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalog: categories, brands, products
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

enum ProductType {
  SPARE_PART
  SCOOTER
  ACCESSORY
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Base commerce entity for every purchasable item, spare part or
// scooter alike (Section 10A) - cart/checkout/orders/inventory all
// operate on Product (and optionally ProductVariant) regardless of
// productType. Money fields are integer paise, matching
// packages/utils formatIndianRupees(paise).
model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  sku         String        @unique
  partNumber  String?
  name        String
  description String?
  productType ProductType
  status      ProductStatus @default(DRAFT)

  categoryId String
  brandId    String?

  price          Int // paise
  mrp            Int // paise
  gstPercent     Decimal @default(0) @db.Decimal(5, 2)
  warrantyMonths Int?

  specifications Json? // free-form spec sheet for spare parts/accessories

  seoTitle       String?
  seoDescription String?
  isFeatured     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category      Category               @relation(fields: [categoryId], references: [id])
  brand         Brand?                 @relation(fields: [brandId], references: [id])
  images        ProductImage[]
  variants      ProductVariant[]
  scooterSpec   ScooterSpecification?
  compatibility ProductCompatibility[]
  inventory     Inventory[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  reviews       Review[]

  @@index([categoryId])
  @@index([brandId])
  @@index([productType])
  @@index([status])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
}

// Color/variant-level SKU + stock. Spare parts generally don't need
// this (stock lives directly on Product via Inventory.productId);
// scooters use it for per-color stock. Kept generic per Section 10A
// so any product can adopt variants later without a schema change.
model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  sku        String   @unique
  color      String?
  priceDelta Int      @default(0) // paise, added to Product.price
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images     ProductImage[]
  inventory  Inventory[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, color])
}

enum BatteryType {
  LI_ION
  LFP
}

// 1:1 extension of Product when productType = SCOOTER (Section 10A).
model ScooterSpecification {
  id        String @id @default(cuid())
  productId String @unique

  brand   String?
  model   String
  variant String?

  batteryCapacityAh Float?
  batteryCapacityWh Float?
  batteryType       BatteryType

  motorPowerW       Int
  topSpeedKmh       Int
  rangeKm           Int
  chargingTimeHours Float

  brakingType       String?
  tyreType          String?
  tyreSize          String?
  suspension        String?
  kerbWeightKg      Float?
  loadCapacityKg    Float?
  seatHeightMm      Int?
  groundClearanceMm Int?

  warrantyTerms     String?
  highlightFeatures Json? // string[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Vehicle compatibility (Section 10)
// ---------------------------------------------------------------------------

model VehicleBrand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models VehicleModel[]
}

model VehicleModel {
  id             String   @id @default(cuid())
  vehicleBrandId String
  name           String
  slug           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  brand    VehicleBrand     @relation(fields: [vehicleBrandId], references: [id], onDelete: Cascade)
  variants VehicleVariant[]

  @@unique([vehicleBrandId, slug])
}

model VehicleVariant {
  id             String   @id @default(cuid())
  vehicleModelId String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  model         VehicleModel           @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)
  years         VehicleYear[]
  compatibility ProductCompatibility[]

  @@unique([vehicleModelId, name])
}

model VehicleYear {
  id               String   @id @default(cuid())
  vehicleVariantId String
  year             Int
  createdAt        DateTime @default(now())

  variant       VehicleVariant         @relation(fields: [vehicleVariantId], references: [id], onDelete: Cascade)
  compatibility ProductCompatibility[]

  @@unique([vehicleVariantId, year])
}

// Maps one spare part to many compatible vehicles. vehicleYearId is
// optional - most parts are compatible with a variant across all its
// years, only some need a specific model-year called out.
model ProductCompatibility {
  id               String   @id @default(cuid())
  productId        String
  vehicleVariantId String
  vehicleYearId    String?
  notes            String?
  createdAt        DateTime @default(now())

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleVariant VehicleVariant @relation(fields: [vehicleVariantId], references: [id], onDelete: Cascade)
  vehicleYear    VehicleYear?   @relation(fields: [vehicleYearId], references: [id], onDelete: Cascade)

  @@unique([productId, vehicleVariantId, vehicleYearId])
  @@index([vehicleVariantId])
}

// ---------------------------------------------------------------------------
// Inventory (Section 16)
// ---------------------------------------------------------------------------

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory Inventory[]
}

// Exactly one of productId/variantId is set - enforced by a CHECK
// constraint added in the migration (Postgres treats NULLs as
// distinct, so @@unique alone can't guarantee "one row per
// warehouse+product when variantId is null"; two partial unique
// indexes are added in the migration for that). See docs/database.md.
model Inventory {
  id                String   @id @default(cuid())
  warehouseId       String
  productId         String?
  variantId         String?
  currentStock      Int      @default(0)
  reservedStock     Int      @default(0)
  lowStockThreshold Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@index([productId])
  @@index([variantId])
}

enum StockMovementType {
  RESERVE
  RELEASE
  DEDUCT
  RESTOCK
  ADJUSTMENT
}

model StockMovement {
  id            String            @id @default(cuid())
  inventoryId   String
  type          StockMovementType
  quantity      Int
  reason        String?
  referenceType String? // e.g. "Order"
  referenceId   String?
  performedById String?
  createdAt     DateTime          @default(now())

  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  performedBy User?     @relation(fields: [performedById], references: [id])

  @@index([inventoryId])
}

// ---------------------------------------------------------------------------
// Cart & Wishlist
// ---------------------------------------------------------------------------

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  productId     String
  variantId     String?
  quantity      Int
  savedForLater Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

// ---------------------------------------------------------------------------
// Orders, payments, shipments (Sections 12-15)
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String
  status      OrderStatus @default(PENDING)

  subtotal       Int // paise
  discountAmount Int @default(0)
  shippingAmount Int @default(0)
  taxAmount      Int @default(0)
  totalAmount    Int

  couponId          String?
  shippingAddressId String
  billingAddressId  String?

  placedAt           DateTime  @default(now())
  confirmedAt        DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User                 @relation(fields: [userId], references: [id])
  items           OrderItem[]
  payment         Payment?
  shipment        Shipment?
  coupon          Coupon?              @relation(fields: [couponId], references: [id])
  shippingAddress Address              @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress  Address?             @relation("BillingAddress", fields: [billingAddressId], references: [id])
  returns         Return[]
  statusHistory   OrderStatusHistory[]

  @@index([userId])
  @@index([status])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderItem {
  id                  String  @id @default(cuid())
  orderId             String
  productId           String
  variantId           String?
  productNameSnapshot String
  skuSnapshot         String
  quantity            Int
  unitPrice           Int // paise
  mrp                 Int // paise
  discountAmount      Int     @default(0)
  totalAmount         Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  RAZORPAY
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  method            PaymentMethod @default(RAZORPAY)
  status            PaymentStatus @default(PENDING)
  amount            Int // paise
  currency          String        @default("INR")
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([razorpayOrderId])
}

enum ShipmentStatus {
  PENDING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

// No live tracking map by design (Sections 15 & 56) - status +
// timeline (OrderStatusHistory) drive the customer tracking UI.
model Shipment {
  id                 String         @id @default(cuid())
  orderId            String         @unique
  status             ShipmentStatus @default(PENDING)
  courierName        String?
  awbNumber          String?
  trackingUrl        String?
  shippedAt          DateTime?
  expectedDeliveryAt DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Reviews, offers, coupons
// ---------------------------------------------------------------------------

model Review {
  id         String   @id @default(cuid())
  userId     String
  productId  String
  rating     Int
  title      String?
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model Offer {
  id          String    @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum CouponType {
  PERCENTAGE
  FLAT
}

model Coupon {
  id                String     @id @default(cuid())
  code              String     @unique
  type              CouponType
  value             Int // percent (0-100) or paise, per type
  minOrderAmount    Int        @default(0)
  maxDiscountAmount Int?
  usageLimit        Int?
  usedCount         Int        @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  orders Order[]
}

// ---------------------------------------------------------------------------
// Returns, refunds, notifications
// ---------------------------------------------------------------------------

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKED_UP
  RECEIVED
  COMPLETED
}

model Return {
  id          String       @id @default(cuid())
  orderId     String
  orderItemId String?
  userId      String
  reason      String
  status      ReturnStatus @default(REQUESTED)
  adminNote   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id])
  refund Refund?

  @@index([orderId])
  @@index([userId])
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Refund {
  id               String       @id @default(cuid())
  returnId         String?      @unique
  paymentId        String
  amount           Int // paise
  status           RefundStatus @default(PENDING)
  razorpayRefundId String?
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  return  Return? @relation(fields: [returnId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

enum NotificationType {
  ORDER
  PAYMENT
  SHIPMENT
  RETURN
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ---------------------------------------------------------------------------
// Admin audit log (Section 53)
// ---------------------------------------------------------------------------

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  adminUser User @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([entityType, entityId])
}
