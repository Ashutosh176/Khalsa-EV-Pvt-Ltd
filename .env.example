# Runtime URLs
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001

# Infrastructure (development values only)
DATABASE_URL=postgresql://khalsa_ev:khalsa_ev@localhost:5432/khalsa_ev?schema=public
REDIS_URL=redis://localhost:6379

# Authentication - generate unique production values
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
COOKIE_SECRET=replace-with-a-long-random-secret
ADMIN_SEED_EMAIL=admin@khalsaev.com
ADMIN_SEED_PASSWORD=replace-before-running-the-seed

# MSG91 - required for phone OTP verification (Register + OTP Login).
# The OTP itself is sent/verified client-side by MSG91's Widget SDK
# (NEXT_PUBLIC_ vars, safe to expose in the browser - widgetId/tokenAuth
# are MSG91's client-safe credentials, distinct from the server authkey).
# MSG91_AUTH_KEY is the server-side secret used only to redeem the
# widget's access-token via /auth/otp/verify-widget. Get all three from
# your MSG91 dashboard under OTP > Widgets.
MSG91_AUTH_KEY=
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_WIDGET_TOKEN_AUTH=

# Integrations - add real credentials only when their phases begin
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_CHANNEL_ID=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=
RESEND_API_KEY=
EMAIL_FROM=
SENTRY_DSN=
