{
  "name": "khalsa-ev",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev:web": "corepack pnpm --filter @khalsa-ev/web dev:https",
    "dev:web:http": "corepack pnpm --filter @khalsa-ev/web dev",
    "dev:admin": "corepack pnpm --filter @khalsa-ev/admin dev",
    "dev:api": "corepack pnpm --filter @khalsa-ev/api start:dev",
    "build": "corepack pnpm -r build",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test"
  }
}
